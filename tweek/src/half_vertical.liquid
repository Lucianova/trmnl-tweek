<div class="layout layout--col layout--stretch">
  {% if error %}
    {% render 'error_state', error: error %}
  {% else %}
    {% comment %} Agenda from today to the end of the week; the layout clips whatever doesn't fit {% endcomment %}
    <div class="flex flex--col flex--stretch-x gap--small">
      {% assign upcoming = 0 %}
      {% for day in days %}
        {% if day.full_date >= today %}
          {% assign upcoming = upcoming | plus: 1 %}
          <div class="flex flex--col flex--stretch-x gap--[4px] no-shrink">
            {% render 'day_header', day: day, today: today, align: 'left', say_today: true %}
            {% if day.tasks.size == 0 %}
              <span class="label label--small label--gray 1bit:text--black">Nothing planned</span>
            {% else %}
              {% render 'day_tasks', day: day, max: 4, align: 'left' %}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if upcoming == 0 %}
        <span class="label label--gray 1bit:text--black">Nothing else planned this week</span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% render 'title_bar', week_label: week_label %}
