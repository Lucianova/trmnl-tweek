{% comment %}
  TRMNL prepends this file to every layout. It holds what the layouts share:
  "today" in the user's timezone, and the partials below. Layouts call a partial
  with render and pass it every variable it uses; partials don't inherit any.
  Custom fields: api_key and calendar_id feed the polling URL/headers; week_start_day
  and time_format are read by the transform.
{% endcomment %}
{% assign today = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}

{% comment %} One task: Google Calendar events as black cards, Tweek to-dos outlined. Text steps up on large screens (TRMNL X) {% endcomment %}
{% template task_card %}
{% if task.gcal %}
  <div class="bg--black rounded--small p--1 no-shrink">
    <span class="label label--small lg:label--base label--inverted block">{% if task.time %}<strong>{{ task.time }}</strong> {% endif %}{% if task.done %}<s>{{ task.text }}</s>{% else %}{{ task.text }}{% endif %}{% if task.all_day %} (all-day){% endif %}</span>
  </div>
{% else %}
  <span class="label label--small lg:label--base label--outline rounded--small p--1 block no-shrink">{% if task.time %}<strong>{{ task.time }}</strong> {% endif %}{% if task.done %}<s>{{ task.text }}</s>{% else %}{{ task.text }}{% endif %}</span>
{% endif %}
{% endtemplate %}

{% comment %} Day header with a dotted rule below; today is an inverted pill. align: center-x | left; say_today: prefix the pill with "Today ·" where there is room {% endcomment %}
{% template day_header %}
{% if day.full_date == today %}
  <div class="flex flex--{{ align }} py--1 border--h-3">
    <span class="label lg:label--large label--inverted rounded--full px--3 py--0">{% if say_today %}Today · {% endif %}{{ day.name }} {{ day.date_label }}</span>
  </div>
{% else %}
  <div class="flex flex--row flex--{{ align }} gap--xsmall py--1 border--h-3">
    <span class="label lg:label--large">{{ day.name }}</span>
    <span class="label lg:label--large">{{ day.date_label }}</span>
  </div>
{% endif %}
{% endtemplate %}

{% comment %} A day's first `max` tasks, then "+N more" for the rest (shown here or capped by the transform) {% endcomment %}
{% template day_tasks %}
{% for task in day.tasks limit: max %}
  {% render 'task_card', task: task %}
{% endfor %}
{% assign shown = day.tasks.size | at_most: max %}
{% assign more = day.tasks.size | plus: day.overflow | minus: shown %}
{% if more > 0 %}
  <div class="flex flex--{{ align }} mt--auto">
    <span class="label label--gray 1bit:text--black">+{{ more }} more</span>
  </div>
{% endif %}
{% endtemplate %}

{% comment %}
  The 7-column week (full and half_horizontal). Portrait: Mon–Thu over Fri–Sun, each row
  half the screen. rounded--none clips a day that overflows (every rounded-- class sets
  overflow:hidden) so it never pushes the other row away.
{% endcomment %}
{% template week_grid %}
<div class="grid grid--cols-7 portrait:grid--cols-4 gap--none stretch">
  {% for day in days %}
    <div class="flex flex--row flex--stretch-y gap--none rounded--none portrait:h--[50cqh]">
      {% comment %} Divider before every day but Monday; Friday starts the second row in portrait, so it hides there to leave the row's left edge open {% endcomment %}
      {% unless forloop.first %}<div class="bg--black w--[1px] no-shrink{% if forloop.index == 5 %} portrait:hidden{% endif %}"></div>{% endunless %}
      <div class="flex flex--col flex--stretch-x stretch">
        {% render 'day_header', day: day, today: today, align: 'center-x' %}
        <div class="flex flex--col flex--stretch-x px--1 pt--1 gap--[4px] stretch">
          {% render 'day_tasks', day: day, max: max, align: 'center-x' %}
        </div>
      </div>
    </div>
  {% endfor %}
  {% comment %} Portrait only: fill the empty 8th cell below a blank header-height strip, so the fill starts at the dotted header line like the day columns; its left edge closes Sunday {% endcomment %}
  <div class="hidden portrait:block rounded--none border--v-black portrait:h--[50cqh]">
    <div class="flex py--1"><span class="label">&nbsp;</span></div>
    <div class="bg--gray-70 h--full"></div>
  </div>
</div>
{% endtemplate %}

{% comment %} Fills the layout and centers the message; the layout itself always stretches {% endcomment %}
{% template error_state %}
<div class="flex flex--col flex--center-x flex--center-y gap--xsmall stretch">
  <span class="title title--small">Couldn't load your week</span>
  <span class="label label--small label--gray 1bit:text--black text--center">{{ error }}</span>
</div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <img class="image" src="data:image/png;base64," />
  <span class="title">Tweek{% if week_label != blank %} | {{ week_label }}{% endif %}</span>
</div>
{% endtemplate %}
