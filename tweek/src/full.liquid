{% comment %}Custom fields consumed by serverless function: api_key, calendar_id, week_start_day, time_format{% endcomment %}
{% assign today = trmnl.system.timestamp_utc | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}

<div class="layout layout--col layout--stretch">
  {% if error %}
    <div class="layout layout--center h--full">
      <div class="flex flex--col flex--center-x gap--xsmall">
        <span class="title title--small">Couldn't load your week</span>
        <span class="label label--small label--gray 1bit:text--black">{{ error }}</span>
      </div>
    </div>
  {% else %}
    <div class="grid grid--cols-7 gap--none grow" style="overflow:hidden">
      {% for day in days %}
        <div class="flex flex--col flex--stretch" style="{% unless forloop.last %}border-right:1px solid black;{% endunless %} overflow:hidden; min-width:0">

          {% comment %} Column header — inverted pill for today {% endcomment %}
          {% if day.full_date == today %}
            <div class="flex flex--center-x py--1" style="border-bottom:1px dashed black">
              <span class="label label--xsmall label--inverted rounded--full px--3 py--0">{{ day.name }} {{ day.full_date | date: "%-m/%-d" }}</span>
            </div>
          {% else %}
            <div class="flex flex--row flex--center-x gap--xsmall py--1" style="border-bottom:1px dashed black">
              <span class="label label--xsmall text--bold">{{ day.name }}</span>
              <span class="label label--xsmall">{{ day.full_date | date: "%-m/%-d" }}</span>
            </div>
          {% endif %}

          {% comment %} Task list {% endcomment %}
          <div class="flex flex--col flex--stretch px--1 pt--1 gap--[4px] grow" style="overflow:hidden">
            {% for task in day.tasks %}
              {% if task.gcal %}
                <div class="bg--black rounded--small p--1">
                  <span class="label label--xsmall label--inverted px--0 py--0" style="font-size:9px; word-break:break-word; display:block">
                    {% if task.time %}<strong>{{ task.time }}</strong> {% endif %}{% if task.done %}<s>{{ task.text }}</s>{% else %}{{ task.text }}{% endif %}{% if task.all_day %} (all-day){% endif %}
                  </span>
                </div>
              {% else %}
                <div class="rounded--small p--1" style="border:1px solid black">
                  <span class="label label--xsmall" style="font-size:9px; word-break:break-word; display:block">{% if task.done %}<s>{{ task.text }}</s>{% else %}{{ task.text }}{% endif %}</span>
                </div>
              {% endif %}
            {% endfor %}

            {% if day.overflow > 0 %}
              <div class="flex flex--center-x mt--auto">
                <span class="label label--xsmall label--gray 1bit:text--black">+{{ day.overflow }} more</span>
              </div>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="data:image/png;base64," />
  <span class="title">Tweek — {{ week_label }}</span>
</div>
