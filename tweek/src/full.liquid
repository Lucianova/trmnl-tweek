<div class="layout layout--col {% if error %}layout--center{% else %}layout--stretch{% endif %}">
  {% if error %}
    {% render 'error_state', error: error %}
  {% else %}
    {% render 'week_grid', days: days, today: today, max: 8 %}
  {% endif %}
</div>

{% render 'title_bar', week_label: week_label %}
