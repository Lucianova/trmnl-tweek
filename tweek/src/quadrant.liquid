<div class="layout layout--col layout--stretch">
  {% if error %}
    {% render 'error_state', error: error %}
  {% else %}
    {% comment %} Today only {% endcomment %}
    {% assign today_day = days | where: "full_date", today | first %}
    <div class="flex flex--col flex--stretch-x gap--[4px]">
      {% if today_day %}
        {% render 'day_header', day: today_day, today: today, align: 'left', say_today: true %}
        {% if today_day.tasks.size == 0 %}
          <span class="label label--small label--gray 1bit:text--black">Nothing planned today</span>
        {% else %}
          {% render 'day_tasks', day: today_day, max: 3, align: 'left' %}
        {% endif %}
      {% else %}
        <span class="label label--gray 1bit:text--black">Nothing planned today</span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% render 'title_bar', week_label: week_label %}
