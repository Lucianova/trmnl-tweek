<div class="layout layout--col {% if error %}layout--center{% else %}layout--stretch{% endif %}">
  {% if error %}
    {% render 'error_state', error: error %}
  {% else %}
    {% comment %} The full week, each day trimmed to its first 2 tasks so it fits the short strip {% endcomment %}
    {% render 'week_grid', days: days, today: today, max: 2 %}
  {% endif %}
</div>

{% render 'title_bar', week_label: week_label %}
